# --- database (Supabase Postgres, async driver) ---
DATABASE_URL=postgresql+asyncpg://moveyourass:moveyourass@localhost:5433/moveyourass

# --- auth ---
# min. 32 random chars in production (openssl rand -hex 32)
JWT_SECRET=change-me
# Web OAuth client id(s) used to verify Google ID tokens (first one is
# also used by the admin login button).
GOOGLE_CLIENT_IDS=["xxx.apps.googleusercontent.com"]
FIRST_ADMIN_EMAIL=you@example.com

# --- Supabase Storage (private bucket) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=photos

# --- push (path inside the container to the service account json) ---
# put the service account json in ./secrets/ (git-ignored) on the server
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json

# --- misc ---
CONTACT_EMAIL=you@example.com
SCHEDULER_ENABLED=true

# --- deployment ---
IMAGE_PREFIX=ghcr.io/konwys01/moveyourass
# The domain is NOT configured here: it lives in the shared Caddy (README).
